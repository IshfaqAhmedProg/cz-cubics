{
  "name": "cz-cubics",
  "version": "0.0.10",
  "description": "A customizable Commitizen adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/IshfaqAhmedProg/cz-cubics"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./commitlint.config.js": {
      "types": "./dist/commitlint.config.d.cts",
      "default": "./dist/commitlint.config.cjs"
    },
    "./config.type": {
      "types": "./dist/index.d.cts"
    }
  },
  "files": [
    "commitlint.config.js",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "commitizen",
    "commitizen-adapter",
    "cz"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "peerDependencies": {
    "commitizen": "^4"
  },
  "dependencies": {
    "find-up": "^8.0.0",
    "fuse.js": "^7.5.0",
    "inquirer-autocomplete-prompt": "^2.0.1",
    "inquirer-maxlength-input-prompt": "^1.0.2",
    "pad": "^3.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.4.0",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  }
}
